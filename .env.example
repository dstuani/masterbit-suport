# ─── Supabase ─────────────────────────────────────────────────────────────────
# Painel do Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"

# Projetos novos: chave "Publishable key" (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="cole-aqui-a-publishable-key"
# Projetos antigos usam a anon key; qualquer uma das duas serve.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Usada apenas em rotinas administrativas no servidor (nunca exposta ao browser).
# Deixe em branco enquanto não for necessária.
SUPABASE_SERVICE_ROLE_KEY=""

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3100"
