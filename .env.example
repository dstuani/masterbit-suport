# ─── Supabase ─────────────────────────────────────────────────────────────────
# Painel do Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"

# Projetos novos: chave "Publishable key" (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="cole-aqui-a-publishable-key"
# Projetos antigos usam a anon key; qualquer uma das duas serve.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Só para rotinas administrativas no servidor (nunca exposta ao browser) — hoje,
# criar usuário em Configurações → Equipe sem passar pelo painel do Supabase.
# Ignora todo o RLS: cole aqui só se for usar essa tela. Painel do Supabase →
# Project Settings → API → service_role. Deixe em branco enquanto não usar.
SUPABASE_SERVICE_ROLE_KEY=""

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3100"
